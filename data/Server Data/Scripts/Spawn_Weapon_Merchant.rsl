Using "RC_Core.rcm"
; Define entry function 'Main'

Function Main()

NPC = Actor()

SetName(NPC, "Bob")
SetTag(NPC, "Weapon Merchant")

giveitem(NPC,"long sword", 2)
giveitem(NPC, "battle axe", 1)
giveitem(NPC, "scimitar", 1)
giveitem(NPC, "short bow", 1)
giveitem(NPC, "round shield", 2)
giveitem(NPC, "kite shield", 1)
giveitem(NPC,"leather armor", 2)
giveitem(NPC, "leather cap", 2)
giveitem(NPC, "leather trousers", 2)
giveitem(NPC, "leather gloves", 2)
giveitem(NPC, "breast plate", 1)
giveitem(NPC, "plate helmet", 1)
giveitem(NPC, "plated greaves", 1)
giveitem(NPC, "plated gauntlets", 1)

End Function